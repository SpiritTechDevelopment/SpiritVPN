# Образец окружения среды. На сервере лежит его копия с именем .env рядом с
# docker-compose.yml; в репозиторий она не попадает.
#
# Кавычки вокруг значений не ставить. Этот же файл читает `docker run
# --env-file` при накате схемы, а он берёт значение буквально, вместе с
# кавычками.

# --- образы ------------------------------------------------------------------

SPIRITVPN_REGISTRY=ghcr.io/spirittechdevelopment

# Тег обоих образов. Строку переписывает deploy.sh, руками её править не нужно.
SPIRITVPN_TAG=sha-0000000000000000000000000000000000000000

# --- база --------------------------------------------------------------------
#
# Значение одно, а имён у него два: процесс читает SPIRIT_DATABASE_URL, команда
# миграций — DATABASE_URL. Расходятся они молча, и результат расхождения
# такой: миграции уезжают в одну базу, процесс работает с другой.

SPIRIT_DATABASE_URL=postgres://spiritvpn:PASSWORD@db.internal:5432/spiritvpn?sslmode=verify-full
DATABASE_URL=postgres://spiritvpn:PASSWORD@db.internal:5432/spiritvpn?sslmode=verify-full

SPIRIT_DB_MAX_CONNS=10

# --- адреса и логи -----------------------------------------------------------

SPIRIT_LOG_LEVEL=info
SPIRIT_GRPC_LISTEN=:8443
SPIRIT_HTTP_LISTEN=:8080

# --- mTLS: входящие от product-сервиса ---------------------------------------
#
# Пара, которой backend предъявляет себя вызывающему. CLIENT_CA — тот CA,
# которым подписаны сертификаты вызывающих.

SPIRIT_GRPC_TLS_CERT_FILE=/secrets/server.crt
SPIRIT_GRPC_TLS_KEY_FILE=/secrets/server.key
SPIRIT_GRPC_TLS_CLIENT_CA_FILE=/secrets/clients-ca.crt

# --- mTLS: исходящие к агентам нод -------------------------------------------
#
# Пара отдельная от серверной. Здесь backend приходит клиентом к агенту, там
# принимает product-сервис; общий сертификат смешал бы две роли. CA тоже свой —
# им подписаны сертификаты агентов, и серверному CA он не равен.

SPIRIT_AGENT_TLS_CERT_FILE=/secrets/agent-client.crt
SPIRIT_AGENT_TLS_KEY_FILE=/secrets/agent-client.key
SPIRIT_AGENT_TLS_CA_FILE=/secrets/agents-ca.crt

# --- роли --------------------------------------------------------------------
#
# Идентичности из DNS SAN и URI SAN сертификатов вызывающих, через запятую. Поле
# CN не читается: сертификат с именем только в CN идентичности не имеет.
#
# Роли независимы, иерархии между ними нет. Сервису, который и записывает, и
# читает, идентичность вписывается в обе строки одним и тем же значением.

SPIRIT_ROLE_CUSTOMER_ACCESS_WRITER=product-svc.internal
SPIRIT_ROLE_CUSTOMER_ACCESS_READER=product-svc.internal
SPIRIT_ROLE_MANIFEST_WRITER=infra-ci.internal

# --- ключ шифрования client_uuid ---------------------------------------------
#
# Формат <key_id>:<base64 32 байта>, например prod-1:hUx...
#
# Задаётся файлом, а не значением: переменная окружения видна в docker inspect.
# Процесс читает _FILE первым и к самой SPIRIT_CLIENT_UUID_KEY обращается, только
# если путь пуст.
#
# Значение задаётся один раз при заведении базы и дальше не меняется. Смена
# делает нечитаемыми все уже выданные ссылки: активный ключ в v1 один,
# decrypt-only ключей нет, перешифровать базу нечем.
#
# У сред ключи разные. Разные key_id (dev-1 и prod-1) видны в логе старта и в
# колонке encryption_key_id, так что подключение процесса к чужой базе
# обнаруживается сразу.

SPIRIT_CLIENT_UUID_KEY_FILE=/secrets/client_uuid.key
